# Copy to .env.oidc (or .env) before running docker compose for OIDC.

# Optional admin credentials for Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional host port mapping
KEYCLOAK_PORT=8081

# Paths for realm import and custom themes.
# Use absolute paths if you run compose from outside the vetcare repository.
KEYCLOAK_REALM_IMPORT_PATH=./infra/keycloak/realm-import
KEYCLOAK_THEMES_PATH=./infra/keycloak/themes
